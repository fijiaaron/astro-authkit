---

let menu_items = [
	{ link:"HOME", url: "/"},
	{ link:"DASHBOARD", url: "/dashboard"},
	{ link:"ADMIN", url: "/admin"},
	{ link:"SUPPORT", url: "/support"},
	
]

import { Image } from 'astro:assets';
import releasedashboard from "../../assets/releasedashboard.png";

---

<script>
	
	document.querySelector("#menu-button")?.addEventListener("click", function() {
		console.log("toggle menu ")
		var main_menu:HTMLElement|null = document.querySelector("#main-menu");
		console.log("main_menu: ", main_menu);
		
		if (main_menu)
			if (main_menu.style.display && main_menu.style.display != "none") {
				main_menu.style.display="none";
			} else {
				main_menu.style.display="flex";
			}
	})
</script>

<header>

	<div id="logo">
		<a href="/">
			<!-- LOGO -->
			 <img src="/releasedashboard.png" alt="Release Dashboard" title="Release Dashboard" style="height: 1.25rem"/>
			<!-- <Image src={releasedashboard} height={25} alt="Release Dashboard"></Image> -->
		</a>
	</div>
 
	<div id="main-menu">

			<nav id="menu-links">
			{
				menu_items.map(item => 
					<span class="menu-item">
						<a href={item.url}>{item.link}</a>
					</span>
				)
			}
			</nav>


			<div id="menu-other">

				<div id="login">
					<a href="/login">Login</a>
				</div>
				
			</div>



	</div>
		

	<button id="menu-button"  class="outline" data-theme="none">☰</button>
	
</header>





<style lang="scss">

	header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		
		background-color: white;
		position: sticky;
  		top: 0; 
		z-index: 1000;
		box-shadow: 0px 2px 10px rgba(0,0,0,0.2);
	}

	header #search {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}

	#logo {
		border: 1px dashed blue;
		margin-right: 2rem;
	}

	#main-menu {
		border: 1px dashed green;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		width: 100%;
	}

	#main-menu nav {
		border: 1px dashed orangered;
		white-space: nowrap;
		a {
			padding-left: 1em;
			white-space: nowrap;
		}
	}

	#main-menu #login {
		border: 1px dashed tan;
		a {
			padding-left: 1em;
			white-space: nowrap;
		}
	}

	button#menu-button {
		display: none;
	}

	a{
		text-decoration: none;
		color: #345;
		white-space: nowrap;
	}
	a:hover {
		font-weight: bold;
	}

	// small display
	@media screen and (max-width: 900px) {

		button#menu-button {
			font-size: 1.75em;
			height: 1.0em;
			margin: 0;
			padding: 0;
			padding-bottom: 0.2em; /* move the ☰ up a bit to center */
			display: inline-flex;
			align-items: center;
			justify-content: center;
			background: transparent;
			border: 1px dashed gray;

			border-radius: 0;
			color: darkslategray;
		}

		#main-menu {
			display: flex;
			flex-direction: column;
			align-items: flex-end;

			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background-color: white;
			width: 100%;

			box-shadow: 0px 5px 10px 0px rgba(0,0,0,0.25);
			z-index: 1000;

			padding-top: 0.5rem;
			padding-bottom: 0.5rem;

			display: none; /* default to menu not displayed on small */


			// transition: 0.5s cubic-bezier(.2,.75,.25,1); /* springy-ish */

			transition: all 0.25s;

		}

		#main-menu > * {

			display: flex; 
			flex-direction: column;
			align-items: flex-end;
			width: inherit;

			padding-left: 1.0rem;
			padding-right: 1.0rem;
			padding-bottom: 0.25rem;
			margin-bottom: 0.25rem;

			a {
				display: block;
				margin: 0.2em;				
			}


		}

		#main-menu nav {
			border-bottom: 1px dotted gray;
		}

		#main-menu #login {
			
			
		}

		#main-menu #search {
			padding-top: 0.25rem;
		}

		.menu-closed {
			display: none;
			opacity: 0;
			scale: 0;
			width: 0;
		}

	}

	#secondary-header {

		padding-top: 0.2rem;
		padding-bottom: 0.2rem;

		border: 1px dashed gray;
		background-color: transparent;
		box-shadow: none;
		z-index: 10;
		display: flex;
		flex-direction: row;
		justify-content: flex-end;

		form {
			border: 1px dashed green;

			
		}
	}

</style>
